# Salin ke Vercel Dashboard > Settings > Environment Variables
# Tanpa env var ini, aplikasi memakai SQLite lokal (data/links.db).

# Turso — primary region Singapore (aws-ap-southeast-1)
TURSO_DATABASE_URL=libsql://dragonsx-dragons.aws-ap-southeast-1.turso.io
TURSO_AUTH_TOKEN=token-anda

SECRET_KEY=ganti-dengan-string-acak
